+def _np_apply_byteorder(
+    arr: npt.NDArray[Any],
+    order: Literal["I"] | Literal["S"] | Literal["<"] | Literal[">"] | None,
+) -> npt.NDArray[Any]:
+    """NumPy 2+ compatible replacement for ndarray.newbyteorder (removed in NumPy 2.0)."""
+    if order is None or order == "I":
+        return arr
+    return arr.view(arr.dtype.newbyteorder(order))
