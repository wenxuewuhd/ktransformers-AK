+
+  #if (N_SIZE > 2)
+    #define ACCUMULATE_Z22(lhs, rhs) COMPUTE_DOT(z22, lhs, rhs)
+  #else
+    #define ACCUMULATE_Z22(lhs, rhs)
+  #endif
+
+  #if (N_SIZE > 3)
+    #define ACCUMULATE_Z23(lhs, rhs) COMPUTE_DOT(z23, lhs, rhs)
+  #else
+    #define ACCUMULATE_Z23(lhs, rhs)
+  #endif
+
+#else
+  #define ACCUMULATE_Z20(lhs, rhs)
