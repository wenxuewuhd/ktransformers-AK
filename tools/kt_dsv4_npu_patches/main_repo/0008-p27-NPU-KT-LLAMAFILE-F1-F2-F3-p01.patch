+tools/convert_w8a8_to_gguf_q8_0.py
+
+# 2. 修 BF16 path 的 patch（kt_effective_vec_dot_type）
+kt-kernel/operators/llamafile/moe.hpp
+
+# 3. 重生成 GGUF（layer 3 示例，BF16 12.9 GB / Q8_0 6.85 GB）
