@@ -0,0 +1,67 @@
+# 实测来源: /workspace/models/DeepSeek-V4-Flash-W8A8/config.json (2026-05-26)
+# 量化方案 (来自该 ckpt 的 quantization_config, 非论文 FP4/FP8):
+#   weights:             int8, per-channel (strategy=channel), symmetric, static
+#   input_activations:   int8, per-token   (strategy=token,   dynamic=true), symmetric
+#   format: int-quantized (compressed-tensors)
+#   li_cache_scheme:     int 8-bit (indexer KV)
+# 论文 §4.2.1 / §5.2.1 写的是 MXFP4 weight + FP8 activation；本 ckpt 已落地为 W8A8。
+# README §"已知偏离" 中标注: 本 bench 对齐 ckpt 实际部署 (W8A8), 不对齐论文 FP4×FP8.
+
+model:
+  hidden_size: 4096                # 实测 config.json
+  moe_intermediate_size: 2048      # 实测 config.json (论文 §4.2.1 一致)
+  n_routed_experts: 256            # 实测 config.json
+  num_experts_per_tok: 6           # 实测 config.json
+  n_shared_experts: 1              # 实测 config.json
+  shared_intermediate_size: null   # 留空 -> code 自动算 = n_shared * moe_intermediate = 2048
+  num_hidden_layers: 43            # 实测; 全部 MoE (first_k_dense_replace=0, moe_layer_freq=1)
+
+runtime:
+  device: npu:0
+  weight_dtype: int8               # W8 per-channel scale fp32 (与 ckpt 对齐)
+  weight_scale_dtype: float32
+  weight_scale_strategy: channel   # per-out-channel; weight_scale shape = (E, 2I) / (E, H)
+  act_dtype: bfloat16              # A8 path: bf16 -> npu_dynamic_quant -> int8 + per-token fp32 scale
+  act_scale_strategy: token        # per-token; act_scale shape = (N,)
+  accum_dtype: int32               # grouped matmul accum 内部
+  out_dtype: bfloat16              # grouped matmul 输出 dtype
+
+bench:
+  num_tokens: 1                    # decode bs=1; KT 上游 token 数 (用于 pre-dispatch quant 形状)
+  top_k: 6                         # DSv4-Flash num_experts_per_tok
+  n_active_experts: 6              # NPU 上落了几个 active expert (CPU offload 热专家命中数)
+  tokens_per_expert: 1             # N2: 每 active expert 平均 token 数; N = n_active * tokens_per_expert
+  warmup: 30
+  repeat: 1000                     # S3: M=1 GEMV-scale kernel 抖动大, 默认 1000; --quick-mode 走 100
+  seed: 42
+  sanity: false
+
+sweep:
+  # CPU offload 热专家场景: 命中率 ∈ [0, 1], n_active ∈ {1..6} 全覆盖 (A5)
+  n_active_experts: [1, 2, 3, 4, 5, 6]
+  # 可选: multi-token (但需手动改 num_tokens 配合, 默认主线不跑)
+  n_active_extended: [8, 16, 32]
+
+ops:
+  grouped_matmul: torch_npu.npu_grouped_matmul
+  dynamic_quant:  torch_npu.npu_dynamic_quant
+  quant_matmul:   torch_npu.npu_quant_matmul     # for shared expert (dense)
+  swiglu_fused:   null                            # 若 sgl_kernel_npu 提供 fused swiglu+quant, 填算子名
+  group_list_mode: cumsum                         # cumsum | per_expert (D2 smoke 决定)
+
+roofline:
+  # S1 + N4: 双带宽分别报 util_vs_peak / util_vs_achievable
+  hbm_peak_tb_s: 1.6           # 理论 peak (Ascend 910B HBM2e 标称)
+  hbm_effective_tb_s: 1.20      # D2 实测 measure_hbm_effective_tb_s(npu:0) ≈ 1.20 TB/s
+  bytes_per_weight: 1          # W8 = 1B/权重
+
+msprof:
+  enabled: false
+  profiler_level: "Level1"
+  aic_metrics: "PipeUtilization"
+  skip_first: 5
+  warmup: 2
+  active: 10
+  out_dir: "./npu_results"
+  record_shapes: true
+  with_stack: false
