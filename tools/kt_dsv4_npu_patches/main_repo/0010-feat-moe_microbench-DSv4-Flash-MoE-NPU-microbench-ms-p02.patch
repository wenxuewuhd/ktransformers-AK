+            lines.append(
+                f"| {na} | {cfg.tokens_per_expert} | {n} | {_fmt(_mean(go))} | {_fmt(_mean(do))} | {_fmt(rf_us)} | {_fmt(u_eff)} |"
+            )
+        lines += ["", "> act_quant(pre) 不随 n_active 变化（固定 [num_tokens, H]）。"]
+
+    lines += [
