+    payload = {"kind": "shared_expert", "cfg": {"num_tokens": cfg.num_tokens, "H": cfg.hidden_size, "S": cfg.shared_intermediate_size}, "timing": timing_payload(result)}
+    text = json.dumps(payload, indent=2)
