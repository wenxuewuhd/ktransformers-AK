-def mask_cpu_expert_ids(topk_ids: torch.Tensor, num_gpu_experts: int) -> torch.Tensor:
-    """Mask CPU expert IDs by setting them to -1.
-
-    This function masks expert IDs that should be computed on CPU (IDs >= num_gpu_experts)
-    so they won't be computed on GPU. The masked IDs are set to -1, which causes the
-    GPU MoE kernel to skip those experts.
+def mask_cpu_expert_routing(
+    topk_ids: torch.Tensor,
+    topk_weights: torch.Tensor,
+    num_gpu_experts: int,
+) -> Tuple[torch.Tensor, torch.Tensor]:
+    """Make ``topk_ids/topk_weights`` safe for *both* CUDA and NPU MoE kernels.
+
+    Semantics:
+      - For positions where ``topk_ids < num_gpu_experts`` (GPU experts) — keep id
+        and weight unchanged.
+      - For positions where ``topk_ids >= num_gpu_experts`` (CPU experts owned by
+        ``KTMoEWrapper.submit_forward`` on the other path) — replace the id with
+        ``0`` (a valid GPU expert) and zero the weight.
+
+    Why not just ``topk_ids[mask] = -1`` like baseline?
+      The baseline assumed the downstream GPU MoE accepts ``-1`` as a "skip"
+      sentinel. The NPU path (``hardware_backend/npu/quantization/fused_moe_method_npu.py
+      ::npu_fused_experts``) uses ``npu_moe_init_routing`` (V1) +
+      ``npu_moe_compute_expert_tokens``, which do ``count[expert_idx]++`` with
+      *no* range/sign check — ``-1`` triggers a negative-offset DMA and aicore
+      exception (CANN error 507015, "D-cache→UB bus non-zero response").
+      Mapping CPU rows to ``(expert 0, weight 0)`` is mathematically equivalent
+      (GPU contribution is multiplied by 0) and is the safest single-rewrite
+      that keeps shapes static for graph capture.
+
+    Also avoids ``aten.index_put`` (no NPU torchair ge_converter for it, see
+    ERR03007 during graph capture).
+    """
+    is_gpu = topk_ids < num_gpu_experts
+    safe_ids = torch.where(is_gpu, topk_ids, torch.zeros_like(topk_ids))
+    safe_weights = torch.where(is_gpu, topk_weights, torch.zeros_like(topk_weights))
+    return safe_ids, safe_weights
 
-    Args:
-        topk_ids: Tensor of shape [num_tokens, top_k] containing expert IDs
-        num_gpu_experts: Number of experts that should run on GPU (experts 0 to num_gpu_experts-1)
 
-    Returns:
-        Modified topk_ids tensor with CPU expert IDs masked as -1
-    """
-    topk_ids[topk_ids >= num_gpu_experts] = -1
-    return topk_ids
+# Kept as a thin shim for any external caller still using the old name; the
+# meaningful work is now in ``mask_cpu_expert_routing`` (which also zeroes the
+# weights). Do *not* use the ``-1`` sentinel form below for NPU paths.
+def mask_cpu_expert_ids(topk_ids: torch.Tensor, num_gpu_experts: int) -> torch.Tensor:
+    return torch.where(
+        topk_ids < num_gpu_experts,
+        topk_ids,
+        torch.full_like(topk_ids, -1),
+    )
 
 
