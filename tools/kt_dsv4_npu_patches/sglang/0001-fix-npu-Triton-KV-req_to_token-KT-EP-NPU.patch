+# ---------------------------------------------------------------------------
+# Triton availability probe (single-card NPU + KT downstream patch)
+# ---------------------------------------------------------------------------
+# 上游 `sgl_kernel_npu.mem_cache.allocator.alloc_extend_kernel` 是个 ``@triton.jit``
+# 内核，需要 triton-ascend 后端注册到 ``triton.runtime.driver``。在我们这台 NPU
+# docker 里 ``triton 3.7`` 与 ``triton-ascend 3.2`` 是版本错配（ascend/compiler.py
+# 引用了 upstream 已删除的 ``AttrsDescriptor``），后端注册失败，调用就会抛
+# ``RuntimeError: 0 active drivers ([])``；而本文件已经自带的 ``alloc_extend_naive``
+# 是纯 PyTorch 等价实现，bs 较小时性能差异可以忽略。我们在 import 期做一次性探测，
+# 失败则把后续 prefill 全部切到 naive 分支；若 triton-ascend 后续修好，把环境
+# 变量 ``SGLANG_NPU_ALLOC_FORCE_NAIVE`` 显式置 0 即可保留旧行为以做对比测试。
+def _detect_triton_driver_available() -> bool:
+    if os.environ.get("SGLANG_NPU_ALLOC_FORCE_NAIVE", "") == "1":
+        return False
+    try:
+        from triton.runtime.driver import driver as _triton_driver  # type: ignore
+
+        _ = _triton_driver.active  # triggers _create_driver()
+        return True
+    except Exception as e:  # ImportError / RuntimeError("0 active drivers") / etc.
+        logger.warning(
+            "[allocator_npu] Triton driver unavailable (%s: %s); falling back to "
+            "alloc_extend_naive for KV slot allocation. This is a pure-PyTorch path "
+            "and does not affect forward numerics.",
+            type(e).__name__,
+            e,
+        )
+        return False
+
+
+_TRITON_DRIVER_AVAILABLE = _detect_triton_driver_available()
+
